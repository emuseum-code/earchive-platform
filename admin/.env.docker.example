APP_NAME="Архів"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://arch.emuseum.ua
APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
