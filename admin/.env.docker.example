APP_NAME="Облік інвентарних книг"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://books.example.com
APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=books-db
DB_PORT=5432
DB_DATABASE=books
DB_USERNAME=books
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Ключ Gemini (GitHub Secret GEMINI_API_KEY). Порожній = демо-режим.
GEMINI_API_KEY=
